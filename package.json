{
  "name": "picshare-social-app",
  "version": "1.0.0",
  "private": true,
  "description": "Instagram-inspired mini social network with vanilla JS, Express, and MongoDB",
  "scripts": {
    "start": "npm --prefix backend start",
    "dev": "npm --prefix backend run dev",
    "test": "npm --prefix backend test",
    "check": "node backend/scripts/check.js",
    "migrate": "node backend/scripts/migrate-communications.js",
    "mobile:build": "node scripts/build-mobile.js",
    "mobile:sync": "npm run mobile:build && cap sync",
    "android:debug": "npm run mobile:sync && cd android && ./gradlew assembleDebug",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor-community/contacts": "^8.0.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capgo/capacitor-social-login": "^8.7.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "esbuild": "^0.28.2"
  }
}
