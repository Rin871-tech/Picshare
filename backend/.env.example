PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/picshare
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=2h
CLIENT_ORIGIN=http://localhost:4000
GOOGLE_CLIENT_ID=
MAX_UPLOAD_MB=5
# Absolute path on a durable mounted volume in production; leave blank locally.
UPLOAD_DIR=
# coturn REST authentication: backend secret never sent to browsers.
TURN_URL=
TURN_SHARED_SECRET=
# Optional HTTPS provider adapter; contract documented in docs/UPGRADE.md.
AI_PROVIDER_URL=
AI_PROVIDER_KEY=
# Use a disposable, separate database for integration tests.
TEST_MONGODB_URI=

# Comma-separated existing user ObjectIds allowed to review safety reports.
ADMIN_USER_IDS=

# Optional: verified reverse-proxy hop count (0-5). Leave blank for direct hosting.
TRUST_PROXY=
